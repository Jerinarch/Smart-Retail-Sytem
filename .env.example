# Supabase Cloud PostgreSQL Connection String (Replace with your credentials or leave blank to auto-fallback to local SQLite)
SUPABASE_CONN_STRING=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Generative AI API Keys (Optional: OpenAI or Groq API for Natural Language to SQL Assistant)
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Local Data Warehouse Database File Path
DWH_DATABASE=data_warehouse.db
